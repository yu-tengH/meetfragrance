---
import NoPhoto from './NoPhoto.astro';
const { product: p } = Astro.props;
---
<a class="card" href={`/products/${p.slug}/`} data-category={p.category}>
  <div class="niche frame">
    {p.image
      ? <img src={p.image} alt={p.name} loading="lazy" />
      : <NoPhoto />}
  </div>
  <div class="meta">
    <h3>{p.name}</h3>
    <p class="scent">{p.scent}</p>
    <p class="price">{p.priceLabel}</p>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: 16px; color: var(--ink); text-decoration: none; }
  .frame {
    aspect-ratio: 4 / 5;
    display: grid; place-items: center;
    padding: 18% 10% 10%;
  }
  .frame img {
    width: 100%; height: 100%; object-fit: contain;
    filter: drop-shadow(0 14px 16px rgba(58, 36, 51, 0.22));
    transition: transform 0.35s ease;
  }
  .card:hover .frame img { transform: translateY(-6px); }
  .meta { display: grid; gap: 2px; padding-inline: 4px; }
  h3 { font-size: var(--step-1); }
  .scent { color: var(--muted); font-size: var(--step--1); }
  .price { font-weight: 500; }
</style>
