---
import Base from '../../layouts/Base.astro';
import NoPhoto from '../../components/NoPhoto.astro';
import ProductCard from '../../components/ProductCard.astro';
import Model3D from '../../components/Model3D.astro';
import { getProducts } from '../../lib/products.js';
import { SITE } from '../../lib/site.js';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p, all: products } }));
}

const { product: p, all } = Astro.props;
const buyUrl = p.buyUrl || SITE.shopUrl;
const related = all.filter((x) => x.slug !== p.slug && x.category === p.category).slice(0, 3);
const details = [
  ['香味', p.scent],
  ['適合', p.goodFor],
  ['使用方式', p.usage],
  ['規格', p.spec],
].filter(([, v]) => v);
---
<Base title={p.name} description={`${p.name}｜${p.scent}。${p.spec}`}>
  <section class="section">
    <div class="wrap">
      <p class="crumb"><a href="/products/">全部商品</a>／{p.category}</p>
      <div class="detail">
        <div class="niche frame">
          {p.image ? <img src={p.image} alt={p.name} /> : <NoPhoto />}
        </div>
        <div class="info">
          <h1>{p.name}</h1>
          <p class="price">{p.priceLabel}</p>
          <dl>
            {details.map(([k, v]) => (<div class="row"><dt>{k}</dt><dd>{v}</dd></div>))}
          </dl>
          <div class="actions">
            <a class="btn btn--solid" href={buyUrl} target="_blank" rel="noopener">到賣貨便購買</a>
            <a class="btn btn--ghost" href={SITE.lineUrl} target="_blank" rel="noopener">LINE 詢問</a>
            {p.model && <Model3D src={p.model} name={p.name} />}
          </div>
          <p class="note">手工製作，每一件的顏色和紋路會有些微不同。</p>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section related">
      <div class="wrap">
        <h2 class="section-title">同系列商品</h2>
        <div class="grid">{related.map((r) => <ProductCard product={r} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .crumb { color: var(--muted); font-size: var(--step--1); margin-bottom: 24px; }
  .detail {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px); align-items: start;
  }
  .frame { aspect-ratio: 4 / 5; display: grid; place-items: center; padding: 16% 10% 10%; }
  .frame img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 20px 22px rgba(58, 36, 51, 0.25)); }
  .info { display: grid; gap: 20px; }
  h1 { font-size: var(--step-3); }
  .price { font-size: var(--step-1); font-weight: 500; }
  dl { margin: 0; border-top: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 6em minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .note { color: var(--muted); font-size: var(--step--1); }
  @media (max-width: 820px) { .detail { grid-template-columns: minmax(0, 1fr); } }

  .related { padding-top: 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: clamp(24px, 4vw, 48px); }
</style>
